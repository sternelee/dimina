.map-page { padding: 24rpx; background: transparent; }
.map { width: 100%; height: 600rpx; }
.caption { margin-bottom: 16rpx; color: #666; font-size: 26rpx; line-height: 1.5; }
.status { margin: 24rpx 0; word-break: break-all; }
.section-title { margin: 24rpx 0 16rpx; font-size: 30rpx; font-weight: bold; }
.results { padding: 0 20rpx 16rpx; background: #f5f5f5; border-radius: 12rpx; }
.results-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.results-header button { flex-shrink: 0; margin: 0; }
.result { padding: 8rpx 0; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.buttons { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.buttons button { width: calc(50% - 8rpx); margin: 0; padding: 0 8rpx; font-size: 24rpx; }
