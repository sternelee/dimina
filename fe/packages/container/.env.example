# Copy to .env.local, fill in your Web (JS API) credentials, and restart the dev server.
VITE_AMAP_WEB_KEY=
# Optional: securityJsCode and serviceHost may both be empty.
VITE_AMAP_SECURITY_JS_CODE=
# Production: configure a server proxy ending in /_AMapService instead of exposing securityJsCode.
VITE_AMAP_SERVICE_HOST=
# Local demo only: set true after consenting to use the AMap service.
VITE_AMAP_PRIVACY_CONSENT=false
